# Configurazione per migrazione MongoDB
# Copia questo file in .env.migration.example e configuralo con i tuoi dati

# Database locale (solitamente localhost)
MONGODB_LOCAL_URI=mongodb://localhost:27017/homebi

# MongoDB Atlas (in produzione)
# Ottieni da: https://cloud.mongodb.com → Cluster → Connect → Connection String
# Formato: mongodb+srv://username:password@clustername.mongodb.net/homebi
MONGODB_ATLAS_URI=mongodb+srv://username:password@your-cluster.mongodb.net/homebi

# Opzioni di backup
BACKUP_DIR=./backups
BACKUP_DATE=$(date +%Y-%m-%d-%H%M%S)

# Note sulla sicurezza:
# ⚠️  NON committare i dati reali nel git!
# 
# Opzioni sicure:
# 1. Crea un file .env.migration (non committato in .gitignore)
# 2. Usa questo file come template
# 3. Cambia i valori con i tuoi dati
# 4. Sourcia le variabili: source .env.migration
# 5. Esegui lo script: node scripts/migrate-mongodb.js ...
