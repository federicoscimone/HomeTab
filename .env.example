# HomeTab configuration.
# `npm run setup` copies this file to .env and fills every "change-me" with a random secret.
# By hand: cp .env.example .env, then replace the change-me values.

# --- MongoDB ---------------------------------------------------------------
# docker compose creates both users the first time the database volume is created.
# Changing them later requires recreating the volume: docker compose down -v
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=hometab
MONGO_APP_USERNAME=hometab_app
MONGO_APP_PASSWORD=change-me

# Only for `npm run dev` outside Docker: inside Docker the app builds its own URI.
# MONGODB_URI=mongodb://localhost:27017/hometab

# --- Authentication ----------------------------------------------------------
# Signs the session cookies: a long random string (openssl rand -hex 32).
NEXTAUTH_SECRET=change-me
# Public URL of the app, used for auth callbacks and for links in emails.
NEXTAUTH_URL=http://localhost:3000

# --- Demo mode -----------------------------------------------------------------
# true: on first start the database is filled with 24 months of fictitious data and
# three demo users. Sign in with mario@test.it / Asdf_lkjH (administrator).
# Set it to false before entering real data: demo mode resets an empty database.
DEMO_MODE=true

# error | warn | info | debug
LOG_LEVEL=info

# --- Email (optional) ----------------------------------------------------------
# Needed for password-reset emails and for two-step verification codes by email.
# Without it the app works normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HomeTab <noreply@example.com>

# --- Telegram (optional) --------------------------------------------------------
# Sign-in and password-reset codes on Telegram. Setup guide: docs/telegram.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public HTTPS deploys (Vercel): set a random secret (letters, digits, _ and -) and Telegram
# delivers messages to /api/telegram/webhook; the app registers the webhook by itself.
# Leave it empty on a server reachable only in the LAN: there the bot process polls Telegram,
# and runs only with the compose profile "telegram" (COMPOSE_PROFILES=telegram).
TELEGRAM_WEBHOOK_SECRET=

# --- Google Drive backup (optional) ---------------------------------------------
# Setup guide: docs/google-drive.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to NEXTAUTH_URL + /api/integrations/google-drive/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Encrypts the Google tokens stored in the database; defaults to NEXTAUTH_SECRET.
GOOGLE_DRIVE_TOKEN_SECRET=
# Shared secret for the scheduled-backup endpoint, called by an external cron.
BACKUP_CRON_SECRET=change-me

# --- Public demo (optional) -------------------------------------------------------
# Secret for /api/demo/reset, which restores the demo data. On Vercel the nightly cron in
# vercel.json sends it automatically. The endpoint works only with DEMO_MODE=true.
CRON_SECRET=change-me

# --- Several instances on one host (optional) -------------------------------------
# Names the containers and the Traefik router, so two stacks don't collide. Default: hometab.
INSTANCE=hometab

# --- Behind a reverse proxy (optional) --------------------------------------------
# Defaults publish the app on port 3000 of every interface. Example for Traefik on an
# existing "edge" network: APP_BIND=127.0.0.1, PUBLIC_NETWORK=edge,
# PUBLIC_NETWORK_EXTERNAL=true, TRAEFIK_ENABLE=true, APP_HOST=hometab.example.com
APP_BIND=0.0.0.0
APP_PORT=3000
PUBLIC_NETWORK=hometab_public
PUBLIC_NETWORK_EXTERNAL=false
TRAEFIK_ENABLE=false
APP_HOST=localhost
