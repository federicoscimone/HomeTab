# --- Mongo root user (admin database) ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_root_password
MONGO_DATABASE=homebi

# --- Mongo app user (used by the Next.js app) ---
MONGO_APP_USERNAME=homebi_app
MONGO_APP_PASSWORD=change_me_app_password

# --- Auth.js ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_random_secret

# Public URL used in email links and auth callbacks.
# Keep https because nginx terminates TLS on port 443.
NEXT_PUBLIC_APP_URL=https://homebi.local

# --- SMTP settings for password-reset emails ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=HomeBI <your_email@example.com># Copia questo file in .env.production sul Raspberry Pi e compila i valori reali.
# NON committare .env.production nel repository.

# Auth.js — genera con: openssl rand -hex 32
AUTH_SECRET=cambia_con_segreto_casuale_lungo_64_caratteri

# URL pubblico dell'app sulla rete locale
NEXT_PUBLIC_APP_URL=http://192.168.1.200:3000

# SMTP per invio email reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tua@email.com
SMTP_PASS=tua_app_password
SMTP_FROM=HomeBI <tua@email.com>

# MONGODB_URI è impostato direttamente in docker-compose.yml
# tramite il nome del servizio (mongodb), non serve qui.
