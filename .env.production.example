# Copia questo file in .env.production sul Raspberry e compila i valori reali.
# NON committare .env.production nel repository.

# --- Mongo root user (admin database) ---
# Sono credenziali nuove: le scegli tu ora, non devono esistere prima.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_root_password
MONGO_DATABASE=hometab

# --- Mongo app user (used by the Next.js app) ---
MONGO_APP_USERNAME=hometab_app
MONGO_APP_PASSWORD=change_me_app_password

# --- Auth.js ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_random_secret

# Public URL used in email links and auth callbacks.
# Keep https because nginx terminates TLS on port 443.
NEXT_PUBLIC_APP_URL=https://hometab.local

# --- SMTP settings (optional for now) ---
# If left empty, app startup is fine. Password-reset email will fail until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HomeTab <noreply@local>
